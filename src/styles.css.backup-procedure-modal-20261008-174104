/* ==========================================================
   AURELIS MOTION
   Adapted from heynuff public site's QuietStudio motion system
   ========================================================== */

.aurelis-title-word {
  display: inline-block;
  margin-right: 0.22em;
}

@media (prefers-reduced-motion: no-preference) {

  .aurelis-title-word {
    animation:
      aurelis-word-enter
      280ms
      cubic-bezier(.23, 1, .32, 1)
      both;

    animation-delay:
      calc(var(--word-index) * 18ms);
  }

  .aurelis-copy-enter {
    animation:
      aurelis-copy-enter
      260ms
      cubic-bezier(.23, 1, .32, 1)
      both;
  }

  .aurelis-copy-delay {
    animation-delay: 75ms;
  }

  .aurelis-brand-enter {
    animation:
      aurelis-brand-enter
      280ms
      cubic-bezier(.23, 1, .32, 1)
      both;

    animation-delay: 40ms;
  }

  .aurelis-brand-copy-delay {
    animation-delay: 90ms;
  }
}

@keyframes aurelis-word-enter {
  from {
    opacity: 0;

    transform:
      translate3d(
        calc((var(--word-index) - 4) * .35rem),
        1.5rem,
        0
      )
      rotate(
        calc((var(--word-index) - 3) * .22deg)
      );
  }

  to {
    opacity: 1;
    transform:
      translate3d(0, 0, 0)
      rotate(0);
  }
}

@keyframes aurelis-copy-enter {
  from {
    opacity: 0;
    transform: translate3d(-1rem, .6rem, 0);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes aurelis-brand-enter {
  from {
    opacity: 0;
    transform: translate3d(1.5rem, .4rem, 0);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .aurelis-title-word,
  .aurelis-copy-enter,
  .aurelis-brand-enter {
    animation: none !important;
  }
}

/* ==========================================================
   AURELIS SEAMLESS HERO MOTION
   Based directly on heynuff QuietStudio enter/exit language.
   Canvas remains stationary; left and right typography move.
   ========================================================== */

@media (prefers-reduced-motion: no-preference) {

  /* --------------------------------------------------------
     DEFAULT / RESTING STATE
     -------------------------------------------------------- */

  .hero .hero-content,
  .hero .hero-brand-lockup,
  .hero .hero-subtitle,
  .hero .hero-cta-group,
  .hero .aurelis-title-word {
    animation: none;
  }

  /* --------------------------------------------------------
     ENTER — LEFT
     heynuff quiet-word-enter + quiet-copy-enter
     -------------------------------------------------------- */

  .hero[data-motion-phase='enter']
  .aurelis-title-word {
    animation:
      aurelis-seamless-word-enter
      280ms
      cubic-bezier(.23, 1, .32, 1)
      both;

    animation-delay:
      calc(var(--word-index) * 18ms);
  }

  .hero[data-motion-phase='enter']
  .hero-subtitle {
    animation:
      aurelis-seamless-copy-enter
      260ms
      cubic-bezier(.23, 1, .32, 1)
      both;

    animation-delay: 45ms;
  }

  .hero[data-motion-phase='enter']
  .hero-cta-group {
    animation:
      aurelis-seamless-copy-enter
      260ms
      cubic-bezier(.23, 1, .32, 1)
      both;

    animation-delay: 75ms;
  }

  /* --------------------------------------------------------
     ENTER — RIGHT
     heynuff quiet-card-enter
     -------------------------------------------------------- */

  .hero[data-motion-phase='enter']
  .hero-brand-lockup {
    animation:
      aurelis-seamless-right-enter
      280ms
      cubic-bezier(.23, 1, .32, 1)
      both;
  }

  /* --------------------------------------------------------
     EXIT — LEFT
     heynuff quiet-copy-exit
     -------------------------------------------------------- */

  .hero[data-motion-phase='exit']
  .hero-content {
    animation:
      aurelis-seamless-left-exit
      220ms
      cubic-bezier(.4, 0, 1, 1)
      both !important;
  }

  /* --------------------------------------------------------
     EXIT — RIGHT
     heynuff quiet-card-exit
     -------------------------------------------------------- */

  .hero[data-motion-phase='exit']
  .hero-brand-lockup {
    animation:
      aurelis-seamless-right-exit
      220ms
      cubic-bezier(.4, 0, 1, 1)
      both !important;
  }
}


