/* Global Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: #FDFBF7;
  color: #2D2D2D;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 400;
  line-height: 1.2;
  color: #2D2D2D;
}

h1 {
  font-size: clamp(3rem, 8vw, 6rem);
  letter-spacing: -0.02em;
}

h2 {
  font-size: clamp(2rem, 5vw, 3.5rem);
  margin-bottom: 1.5rem;
}

h3 {
  font-size: clamp(1.5rem, 3vw, 2.5rem);
  margin-bottom: 0.75rem;
}

p {
  margin-bottom: 1.5rem;
  color: #6B6B6B;
}

/* Focus States for Accessibility */
:focus-visible {
  outline: 2px solid #D4C5B0;
  outline-offset: 3px;
}

/* Skip Link */
.skip-link {
  position: absolute;
  top: -40px;
  left: 0;
  background: #2D2D2D;
  color: white;
  padding: 1rem;
  z-index: 1000;
  transition: top 0.3s ease;
}

.skip-link:focus {
  top: 0;
}

/* Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Container */
.container {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 2rem;
}

.section-padding {
  padding: 8rem 0;
}

.text-center {
  text-align: center;
}

/* Buttons */
.btn {
  display: inline-block;
  padding: 1rem 2.5rem;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  text-decoration: none;
}

.btn-primary {
  background-color: #2D2D2D;
  color: #FDFBF7;
}

.btn-primary:hover {
  background-color: #D4C5B0;
  color: #2D2D2D;
}

.btn-secondary {
  background-color: transparent;
  color: #2D2D2D;
  border: 1px solid #2D2D2D;
}

.btn-secondary:hover {
  background-color: #2D2D2D;
  color: #FDFBF7;
}

/* Navigation */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  padding: 1.5rem 0;
  transition: all 0.3s ease;
}

.navbar.scrolled {
  background-color: rgba(253, 251, 247, 0.98);
  backdrop-filter: blur(10px);
  padding: 1rem 0;
  box-shadow: 0 2px 20px rgba(0, 0, 0, 0.05);
}

.navbar-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.75rem;
  font-weight: 600;
  color: #2D2D2D;
  text-decoration: none;
  letter-spacing: 0.05em;
}

.nav-links {
  display: flex;
  gap: 2.5rem;
  list-style: none;
}

.nav-link {
  color: #2D2D2D;
  text-decoration: none;
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: color 0.3s ease;
}

.nav-link:hover,
.nav-link:focus {
  color: #D4C5B0;
}

/* Mobile Menu */
.mobile-menu-btn {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
}

.hamburger {
  width: 28px;
  height: 2px;
  position: relative;
  transition: all 0.3s ease;
}

.hamburger::before,
.hamburger::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 2px;
  background-color: #2D2D2D;
  transition: all 0.3s ease;
}

.hamburger::before {
  top: -8px;
}

.hamburger::after {
  bottom: -8px;
}

.mobile-menu-active .hamburger {
  transform: rotate(45deg);
}

.mobile-menu-active .hamburger::before {
  top: 0;
  opacity: 0;
}

.mobile-menu-active .hamburger::after {
  bottom: 0;
  transform: rotate(-90deg);
}

/* Hero Section */
.hero {
  position: relative;
  height: 350vh;
  background: #17130f;
}

.hero-stage {
  position: sticky;
  top: 0;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #17130f;
}

.hero-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 1;
  background: #17130f;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background:
    linear-gradient(
      90deg,
      rgba(20, 16, 13, 0.52) 0%,
      rgba(20, 16, 13, 0.18) 45%,
      rgba(20, 16, 13, 0.08) 70%,
      rgba(20, 16, 13, 0.24) 100%
    ),
    linear-gradient(
      180deg,
      rgba(17, 14, 12, 0.25) 0%,
      rgba(17, 14, 12, 0.05) 55%,
      rgba(17, 14, 12, 0.42) 100%
    );
}

.hero-content {
  position: absolute;
  z-index: 5;
  left: clamp(1.5rem, 7vw, 8rem);
  bottom: clamp(3.5rem, 10vh, 8rem);
  width: min(720px, calc(100vw - 3rem));
  color: #FDFBF7;
  text-align: left;
  transform: none;
  transition:
    opacity 420ms ease,
    transform 420ms ease;
}

.hero-eyebrow {
  margin: 0 0 1.25rem;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(253, 251, 247, 0.76);
}

.hero-title {
  margin: 0;
  max-width: 13ch;
  font-size: clamp(3rem, 6vw, 6.8rem);
  line-height: 0.96;
  letter-spacing: -0.045em;
  opacity: 1;
  transform: none;
  text-wrap: balance;
}

.hero-subtitle {
  margin: 1.6rem 0 0;
  max-width: 600px;
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(0.95rem, 1.35vw, 1.15rem);
  line-height: 1.65;
  letter-spacing: 0;
  text-transform: none;
  color: rgba(253, 251, 247, 0.86);
  opacity: 1;
  transform: none;
}

.hero-cta-group {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: flex-start;
  margin-top: 2rem;
  opacity: 1;
  transform: none;
}

.hero-final-cta {
  max-width: 680px;
}

.hero-scroll-indicator {
  position: absolute;
  z-index: 6;
  right: clamp(1.5rem, 4vw, 4rem);
  bottom: 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  color: rgba(253, 251, 247, 0.65);
  font-family: 'Montserrat', sans-serif;
  font-size: 0.58rem;
  letter-spacing: 0.22em;
}

.hero-scroll-line {
  display: block;
  width: 1px;
  height: 42px;
  background: rgba(253, 251, 247, 0.52);
}

@media (max-width: 768px) {
  .hero {
    height: 300vh;
  }

  .hero-content {
    left: 1.25rem;
    right: 1.25rem;
    bottom: 4rem;
    width: auto;
  }

  .hero-title {
    font-size: clamp(2.75rem, 13vw, 4.6rem);
  }

  .hero-subtitle {
    max-width: 92%;
  }

  .hero-cta-group {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-scroll-indicator {
    display: none;
  }
}

/* Procedures Section */
.procedures-section {
  background-color: #FDFBF7;
}

.procedure-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 4rem;
  margin-top: 4rem;
}

.procedure-card {
  background-color: #E8E6E1;
  padding: 3rem 2.5rem;
  transition: all 0.4s ease;
  cursor: pointer;
}

.procedure-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
}

.procedure-title {
  font-size: 1.75rem;
  margin-bottom: 1rem;
  color: #2D2D2D;
}

.procedure-description {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.95rem;
  line-height: 1.8;
  margin-bottom: 2rem;
  color: #6B6B6B;
}

/* Our Approach Section */
.approach-section {
  background-color: #F7F5EB;
}

.approach-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 4rem;
  align-items: center;
}

.approach-content h3 {
  font-size: 1.5rem;
  margin-bottom: 0.75rem;
  color: #2D2D2D;
}

.approach-content p {
  font-family: 'Montserrat', sans-serif;
  font-size: 1rem;
  line-height: 2;
  color: #6B6B6B;
  margin-bottom: 0.5rem;
}

/* Surgeon Section */
.surgeon-section {
  background-color: #FDFBF7;
}

.surgeon-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rem;
  align-items: center;
}

.surgeon-image-placeholder {
  width: 100%;
  height: 500px;
  background-color: #E8E6E1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6B6B6B;
}

.surgeon-info h2 {
  margin-bottom: 1.5rem;
}

.surgeon-name {
  font-size: 3rem;
  margin-bottom: 0.5rem;
}

.surgeon-title {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #D4C5B0;
  margin-bottom: 2rem;
}

.surgeon-demo-note {
  display: inline-block;
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #6B6B6B;
  margin-bottom: 2rem;
}

.surgeon-bio {
  font-family: 'Montserrat', sans-serif;
  line-height: 2;
  max-width: 500px;
}

/* Before & After Section */
.before-after-section {
  background-color: #F7F5EB;
}

.ba-container {
  position: relative;
  width: 100%;
  max-width: 800px;
  margin: 4rem auto;
  height: 500px;
  overflow: hidden;
  border-radius: 2px;
}

.ba-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #E8E6E1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6B6B6B;
}

.ba-slider {
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 2px;
  cursor: ew-resize;
  z-index: 10;
}

.ba-handle {
  position: absolute;
  top: -8px;
  left: 50%;
  transform: translateX(-50%);
  width: 40px;
  height: 40px;
  background-color: #2D2D2D;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 1.2rem;
}

.ba-labels {
  position: absolute;
  top: 20px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 30px;
  z-index: 10;
}

.ba-label {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: white;
  opacity: 0.8;
}

.ba-disclaimer {
  margin-top: 1.5rem;
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #6B6B6B;
}

/* Consultation Form Section */
.consultation-section {
  background-color: #FDFBF7;
}

.form-container {
  max-width: 700px;
  margin: 4rem auto;
}

.form-header h2 {
  text-align: center;
  margin-bottom: 1.5rem;
}

.form-group {
  margin-bottom: 2rem;
}

.form-label {
  display: block;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 0.75rem;
  color: #2D2D2D;
}

.form-input,
.form-select {
  width: 100%;
  padding: 1rem;
  font-family: 'Montserrat', sans-serif;
  font-size: 1rem;
  border: 1px solid #E8E6E1;
  background-color: white;
  color: #2D2D2D;
  transition: all 0.3s ease;
}

.form-input:focus,
.form-select:focus {
  outline: none;
  border-color: #D4C5B0;
  box-shadow: 0 0 0 3px rgba(212, 197, 176, 0.2);
}

.form-input.error,
.form-select.error {
  border-color: #C45E5E;
}

.error-message {
  color: #C45E5E;
  font-size: 0.8rem;
  margin-top: 0.5rem;
  display: none;
}

.form-input.error + .error-message,
.form-select.error + .error-message {
  display: block;
}

.radio-group {
  display: flex;
  gap: 2rem;
  margin-top: 0.5rem;
}

.radio-option {
  display: flex;
  align-items: center;
  cursor: pointer;
}

.radio-option input[type="radio"] {
  margin-right: 0.75rem;
  accent-color: #2D2D2D;
}

.form-note {
  font-size: 0.85rem;
  color: #6B6B6B;
  margin-top: -1rem;
  margin-bottom: 2rem;
}

/* Article Section */
.article-section {
  background-color: #F7F5EB;
}

.article-container {
  max-width: 800px;
  margin: 4rem auto;
}

.article-header h2 {
  font-size: 3rem;
  text-align: center;
  margin-bottom: 3rem;
}

.article-content {
  font-family: 'Cormorant Garamond', serif;
  line-height: 2.2;
  color: #2D2D2D;
}

.article-content h3 {
  font-size: 1.75rem;
  margin-top: 3rem;
  margin-bottom: 1.5rem;
}

.article-content p {
  font-family: 'Montserrat', sans-serif;
  line-height: 2;
  color: #6B6B6B;
  margin-bottom: 1.5rem;
}

.article-cta {
  text-align: center;
  margin-top: 4rem;
}

/* Final CTA Section */
.final-cta-section {
  background-color: #2D2D2D;
  color: #FDFBF7;
  padding: 6rem 0;
  text-align: center;
}

.final-cta-text {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2.5rem, 6vw, 4rem);
  margin-bottom: 3rem;
  color: #FDFBF7;
}

/* Footer */
.footer {
  background-color: #1A1A1A;
  color: #E8E6E1;
  padding: 4rem 0 2rem;
}

.footer-content {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 3rem;
  margin-bottom: 3rem;
}

.footer-brand h3 {
  font-size: 2rem;
  color: #FDFBF7;
  margin-bottom: 1rem;
}

.footer-links h4,
.footer-contact h4 {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 1.5rem;
  color: #E8E6E1;
}

.footer-links ul {
  list-style: none;
}

.footer-links li {
  margin-bottom: 0.75rem;
}

.footer-links a {
  color: #E8E6E1;
  text-decoration: none;
  font-size: 0.9rem;
  transition: color 0.3s ease;
}

.footer-links a:hover {
  color: #D4C5B0;
}

.footer-bottom {
  border-top: 1px solid rgba(232, 230, 225, 0.2);
  padding-top: 2rem;
  text-align: center;
  font-size: 0.85rem;
  color: #E8E6E1;
}

/* Modal */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(45, 45, 45, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background-color: #FDFBF7;
  max-width: 600px;
  width: 90%;
  padding: 3rem;
  position: relative;
  transform: translateY(20px);
  transition: all 0.3s ease;
}

.modal-overlay.active .modal-content {
  transform: translateY(0);
}

.modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: none;
  border: none;
  font-size: 2rem;
  cursor: pointer;
  color: #2D2D2D;
  transition: color 0.3s ease;
}

.modal-close:hover {
  color: #D4C5B0;
}

/* Success State */
.success-message {
  text-align: center;
  padding: 4rem 2rem;
}

.success-icon {
  font-size: 4rem;
  margin-bottom: 1.5rem;
}

.success-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2rem;
  margin-bottom: 1rem;
  color: #2D2D2D;
}

/* Responsive Design */
@media (max-width: 1024px) {
  .procedure-grid {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
  }

  .approach-grid {
    gap: 3rem;
  }

  .surgeon-container {
    gap: 4rem;
  }

  .footer-content {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  h1 {
    font-size: 3.5rem;
  }

  h2 {
    font-size: 2rem;
  }

  .nav-links {
    position: fixed;
    top: 0;
    right: -100%;
    width: 80%;
    height: 100vh;
    background-color: #FDFBF7;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    transition: right 0.4s ease;
  }

  .nav-links.active {
    right: 0;
  }

  .mobile-menu-btn {
    display: block;
  }

  .procedure-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .approach-grid,
  .surgeon-container {
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .ba-container {
    height: 400px;
  }

  .form-container {
    margin: 2rem auto;
  }

  .article-header h2 {
    font-size: 2.5rem;
  }

  .final-cta-text {
    font-size: 2.5rem;
  }

  .footer-content {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .radio-group {
    flex-direction: column;
    gap: 1rem;
  }
}

@media (max-width: 480px) {
  h1 {
    font-size: 2.5rem;
  }

  .section-padding {
    padding: 5rem 0;
  }

  .hero-content {
    transform: translate(-50%, -30%);
  }

  .procedure-card {
    padding: 2rem 1.5rem;
  }

  .surgeon-name {
    font-size: 2.5rem;
  }

  .form-input,
  .form-select {
    padding: 0.875rem;
  }

  .modal-content {
    padding: 2rem;
  }
}


.hero-loading {
  position: absolute;
  inset: 0;
  z-index: 8;
  display: grid;
  place-items: center;
  background: #17130f;
  color: rgba(253, 251, 247, 0.72);
  font-family: 'Montserrat', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

/* ==========================================================
   AURELIS — FINAL NAVIGATION
   Hidden during cinematic hero.
   Revealed only after Procedures begins.
   ========================================================== */

.navbar {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;

  z-index: 1000 !important;

  height: 74px !important;
  padding: 0 !important;

  display: flex !important;
  align-items: center !important;

  background: rgba(253, 251, 247, 0.96) !important;

  border-bottom:
    1px solid rgba(45, 45, 45, 0.08) !important;

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  transition:
    transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
    opacity 0.35s ease !important;

  will-change: transform, opacity;
}

.navbar-hidden {
  transform: translateY(-110%) !important;
  opacity: 0 !important;
  pointer-events: none !important;
}

.navbar-visible {
  transform: translateY(0) !important;
  opacity: 1 !important;
  pointer-events: auto !important;
}

.navbar-content {
  width: 90% !important;
  max-width: 1400px !important;
  height: 100% !important;

  margin: 0 auto !important;

  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
}

/* Brand */

.navbar-brand {
  appearance: none !important;

  border: 0 !important;
  outline: 0;

  background: transparent !important;

  padding: 0 !important;
  margin: 0 !important;

  color: #2d2d2d !important;

  font-family:
    'Cormorant Garamond',
    serif !important;

  font-size: 1.7rem !important;
  font-weight: 500 !important;

  letter-spacing: 0.08em !important;

  line-height: 1 !important;

  text-decoration: none !important;

  cursor: pointer;
}

/* Navigation list */

.navbar .nav-links {
  display: flex;
  align-items: center;

  gap: clamp(1.5rem, 2.4vw, 2.8rem);

  margin: 0 !important;
  padding: 0 !important;

  list-style: none !important;
}

.navbar .nav-links li {
  margin: 0 !important;
  padding: 0 !important;

  list-style: none !important;
}

/* Navigation buttons — no browser-blue links */

.navbar-link {
  appearance: none !important;

  border: 0 !important;
  outline: 0;

  background: transparent !important;

  margin: 0 !important;
  padding: 0.3rem 0 !important;

  color: #2d2d2d !important;

  font-family:
    'Montserrat',
    sans-serif !important;

  font-size: 0.72rem !important;
  font-weight: 500 !important;

  letter-spacing: 0.095em !important;
  text-transform: uppercase !important;

  line-height: 1 !important;

  text-decoration: none !important;

  cursor: pointer;

  opacity: 0.68;

  transition:
    opacity 0.25s ease,
    transform 0.25s ease;
}

.navbar-link:hover {
  opacity: 1;
}

.navbar-link:focus-visible {
  opacity: 1;
  outline: 1px solid rgba(45, 45, 45, 0.5);
  outline-offset: 5px;
}

/* Kill any surviving legacy anchor styling */

.navbar a,
.navbar a:link,
.navbar a:visited,
.navbar a:hover,
.navbar a:active {
  color: #2d2d2d !important;
  text-decoration: none !important;
}

/* Hero must remain untouched by navbar */

.hero {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

/* Offset section jumps for fixed navbar */

#procedures,
#approach,
#surgeon,
#results,
#consultation,
#journal {
  scroll-margin-top: 74px;
}

@media (max-width: 768px) {

  .navbar {
    height: 66px !important;
  }

  .navbar-content {
    width: 92% !important;
  }

  #procedures,
  #approach,
  #surgeon,
  #results,
  #consultation,
  #journal {
    scroll-margin-top: 66px;
  }
}

/* ==========================================================
   AURELIS HERO WORDMARK
   Visible only inside cinematic hero
   ========================================================== */

.hero-brand {
  position: absolute;

  top: 16%;
  right: 3%;
  left: auto;

  transform: none;

  z-index: 10;

  font-family:
    'Cormorant Garamond',
    serif;

  font-size: clamp(3.4rem, 5.5vw, 6rem);
  font-weight: 500;

  letter-spacing: 0.11em;

  line-height: 0.95;

  color: rgba(253, 251, 247, 0.96);

  pointer-events: none;

  text-shadow:
    0 2px 14px rgba(0, 0, 0, 0.16);

  white-space: nowrap;
}

@media (max-width: 768px) {
  .hero-brand {
    top: 13%;
    right: 3%;

    font-size: clamp(2.5rem, 9vw, 3.8rem);
    letter-spacing: 0.09em;
  }
}




