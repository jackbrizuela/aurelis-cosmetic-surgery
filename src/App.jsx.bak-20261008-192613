// Our Approach Section Component
function OurApproach() {
  const sectionRef = useRef(null);
  const [motionState, setMotionState] = useState('before');

  useEffect(() => {
    const section = sectionRef.current;

    if (!section) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setMotionState('active');
          return;
        }

        const rect = entry.boundingClientRect;

        if (rect.top < 0) {
          setMotionState('after');
        } else {
          setMotionState('before');
        }
      },
      {
        threshold: 0.24,
        rootMargin: '-4% 0px -4% 0px'
      }
    );

    observer.observe(section);

    return () => observer.disconnect();
  }, []);

  return (
    <section
      ref={sectionRef}
      className={`approach-section philosophy-section philosophy-${motionState}`}
      id="approach"
    >
      <div className="philosophy-inner">

        <div className="philosophy-kicker">
          AURELIS / PHILOSOPHY
        </div>

        <div className="philosophy-statement">
          <span className="philosophy-line philosophy-line-one">
            THE RIGHT CHANGE
          </span>

          <span className="philosophy-line philosophy-line-two">
            SHOULDN'T
          </span>

          <span className="philosophy-line philosophy-line-three">
            ANNOUNCE ITSELF.
          </span>
        </div>

        <div className="philosophy-intro">
          <p>
            We don't begin with a procedure. We begin with you —
            what you want to refine, what already feels right,
            and where change should stop.
          </p>
        </div>

        <div className="philosophy-principles">

          <article className="philosophy-principle philosophy-principle-one">
            <span className="philosophy-number">01</span>

            <h3>
              Preserve what's distinctive.
            </h3>

            <p>
              The goal isn't to standardize a face or body.
              It's to protect the features and proportions
              that already make them yours.
            </p>
          </article>

          <article className="philosophy-principle philosophy-principle-two">
            <span className="philosophy-number">02</span>

            <h3>
              Proportion over trends.
            </h3>

            <p>
              Aesthetic trends move quickly. Your anatomy doesn't.
              Decisions are guided by balance, structure, and what
              will continue to feel appropriate over time.
            </p>
          </article>

          <article className="philosophy-principle philosophy-principle-three">
            <span className="philosophy-number">03</span>

            <h3>
              Know when enough is enough.
            </h3>

            <p>
              Refinement has a limit. Good planning includes
              knowing what to change — and what should be
              left alone.
            </p>
          </article>

        </div>

      </div>
    </section>
  );
}

