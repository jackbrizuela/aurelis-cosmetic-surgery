// Article Section Component
function FeaturedArticle() {
  const sectionRef = useRef(null);
  const [motionState, setMotionState] = useState('before');

  const articles = [
    {
      number: '01',
      category: 'CONSULTATION',
      title: 'What to expect before you decide.',
      description:
        'The questions worth asking, what we assess, and how a consultation should help you think more clearly.'
    },
    {
      number: '02',
      category: 'RECOVERY',
      title: 'Recovery is part of the result.',
      description:
        'A realistic look at healing, patience, downtime, and why recovery deserves as much planning as surgery.'
    },
    {
      number: '03',
      category: 'PLANNING',
      title: 'How much change is enough?',
      description:
        'A considered way to think about proportion, restraint, and the difference between refinement and reinvention.'
    }
  ];

  useEffect(() => {
    const section = sectionRef.current;

    if (!section) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          setMotionState('active');
          return;
        }

        if (entry.boundingClientRect.top < 0) {
          setMotionState('after');
        } else {
          setMotionState('before');
        }
      },
      {
        threshold: 0.2,
        rootMargin: '-5% 0px -5% 0px'
      }
    );

    observer.observe(section);

    return () => observer.disconnect();
  }, []);

  return (
    <section
      ref={sectionRef}
      className={`articles-section articles-${motionState}`}
      id="articles"
    >
      <div className="articles-inner">

        <header className="articles-heading">

          <div>
            <span className="articles-kicker">
              AURELIS / ARTICLES
            </span>

            <h2>
              <span className="articles-title-line articles-title-one">
                Read before
              </span>

              <span className="articles-title-line articles-title-two">
                you decide.
              </span>
            </h2>
          </div>

          <p className="articles-intro">
            Clear, considered information on procedures,
            recovery, consultations, and the questions worth
            asking before surgery.
          </p>

        </header>


        <div className="articles-grid">

          {articles.map((article, index) => (
            <article
              className={`article-card article-card-${index + 1}`}
              key={article.number}
            >

              <div className="article-card-top">
                <span>{article.number}</span>
                <span>{article.category}</span>
              </div>

              <div className="article-card-body">

                <h3>
                  {article.title}
                </h3>

                <p>
                  {article.description}
                </p>

              </div>

              <button
                type="button"
                className="article-read"
                aria-label={`Read ${article.title}`}
              >
                <span>Read article</span>
                <span aria-hidden="true">↗</span>
              </button>

            </article>
          ))}

        </div>


        <div className="articles-footer">

          <span>
            PROCEDURES
          </span>

          <span>
            RECOVERY
          </span>

          <span>
            CONSULTATION
          </span>

          <span>
            PLANNING
          </span>

        </div>

      </div>
    </section>
  );
}
