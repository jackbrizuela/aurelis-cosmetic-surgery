function Hero() {
  const heroRef = useRef(null);
  const canvasRef = useRef(null);

  useEffect(() => {
    console.log('AURELIS REACT SCRUBBER ACTIVE');

    let lastFrame = -1;

    const intervalId = window.setInterval(() => {
      const hero = heroRef.current;
      const canvas = canvasRef.current;

      if (!hero || !canvas) return;

      const maxScroll = Math.max(
        hero.offsetHeight - window.innerHeight,
        1
      );

      const progress = Math.max(
        0,
        Math.min(
          1,
          -hero.getBoundingClientRect().top / maxScroll
        )
      );

      const frame = Math.max(
        1,
        Math.min(
          120,
          Math.round(
            1 + progress * (120 - 1)
          )
        )
      );

      // heynuff-style seamless motion:
      // content remains present through the cinematic sequence,
      // then exits as the hero gives way to Procedures.
      const motionPhase =
        progress >= 0.78
          ? 'exit'
          : 'enter';

      if (hero.dataset.motionPhase !== motionPhase) {
        hero.dataset.motionPhase = motionPhase;
      }

      if (frame === lastFrame) return;

      lastFrame = frame;

      const img = new Image();

      img.onload = () => {
        const ctx = canvas.getContext('2d');

        if (!ctx) return;

        const dpr = Math.min(
          window.devicePixelRatio || 1,
          2
        );

        const cssWidth = canvas.clientWidth;
        const cssHeight = canvas.clientHeight;

        if (!cssWidth || !cssHeight) return;

        canvas.width = Math.round(cssWidth * dpr);
        canvas.height = Math.round(cssHeight * dpr);

        const cw = canvas.width;
        const ch = canvas.height;

        const iw = img.naturalWidth;
        const ih = img.naturalHeight;

        const canvasRatio = cw / ch;
        const imageRatio = iw / ih;

        let sx = 0;
        let sy = 0;
        let sw = iw;
        let sh = ih;

        if (imageRatio > canvasRatio) {
          sw = ih * canvasRatio;
          sx = (iw - sw) / 2;
        } else {
          sh = iw / canvasRatio;
          sy = (ih - sh) / 2;
        }

        ctx.clearRect(0, 0, cw, ch);

        ctx.drawImage(
          img,
          sx,
          sy,
          sw,
          sh,
          0,
          0,
          cw,
          ch
        );
      };

      img.onerror = () => {
        console.warn(
          'AURELIS frame failed:',
          frame
        );
      };

      img.src =
        `/assets/hero-frames/frame-${String(frame).padStart(4, '0')}.webp`;

    }, 50);

    return () => {
      window.clearInterval(intervalId);
    };
  }, []);

  const scrollToSection = (id) => {
    document.getElementById(id)?.scrollIntoView({
      behavior: 'smooth'
    });
  };

  return (
    <section ref={heroRef} className="hero" id="hero" data-motion-phase="enter">
      <div className="hero-stage">

        <div className="hero-brand-lockup">
          <div className="hero-brand aurelis-brand-enter" aria-label="AURELIS">
            AURELIS
          </div>

          <div className="hero-brand-copy aurelis-copy-enter aurelis-brand-copy-delay">
            <span className="brand-line">
              A considered approach to change,
            </span>

            <span className="brand-line">
              guided by proportion, restraint, and what still feels like you.
            </span>
          </div>
        </div>

        <canvas
          ref={canvasRef}
          className="hero-canvas"
          aria-hidden="true"
        />

        <div className="hero-overlay" />

        <div className="hero-content">

          <p className="hero-eyebrow">
            AURELIS COSMETIC SURGERY
          </p>

          <h1 className="hero-title"><AnimatedHeroText text="Subtle change. Carefully considered." /></h1>

          <p className="hero-subtitle aurelis-copy-enter">
            Cosmetic surgery should never feel rushed, generic, or overdone. Every decision begins with your features, your goals, and what will still feel like you.
          </p>

          <div className="hero-cta-group aurelis-copy-enter aurelis-copy-delay">

            <button
              type="button"
              className="btn btn-primary"
              onClick={() =>
                scrollToSection('consultation')
              }
            >
              Book Online Consultation
            </button>

            <button
              type="button"
              className="btn btn-secondary"
              onClick={() =>
                scrollToSection('procedures')
              }
            >
              Explore Procedures
            </button>

          </div>
        </div>

        <div
          className="hero-scroll-indicator"
          aria-hidden="true"
        >
          <span>SCROLL</span>
          <span className="hero-scroll-line" />
        </div>

      </div>
    </section>
  );
}

