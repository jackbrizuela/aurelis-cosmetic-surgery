// Procedures Section — Editorial Image Gallery
function ProceduresSection() {
  const [selectedProcedure, setSelectedProcedure] = useState(null);
  const [modalClosing, setModalClosing] = useState(false);
  const [headingVisible, setHeadingVisible] = useState(false);
  const headingRef = useRef(null);

  const procedures = [
    {
      title: 'Rhinoplasty',
      image: '/assets/procedures/rhinoplasty.png',
      description:
        'A refined approach to reshaping the nose while preserving balance with the rest of the face.',
      points: [
        'Facial proportion and harmony',
        'Individualized surgical planning',
        'Natural-looking refinement'
      ]
    },
    {
      title: 'Facelift & Neck Lift',
      image: '/assets/procedures/facelift-necklift.png',
      description:
        'Thoughtful facial and neck rejuvenation designed around structure, expression, and proportion.',
      points: [
        'Jawline and neck refinement',
        'Preservation of natural expression',
        'Carefully planned structural support'
      ]
    },
    {
      title: 'Blepharoplasty',
      image: '/assets/procedures/blepharoplasty.png',
      description:
        'A precise approach to the eye area that aims to create a more rested, open appearance.',
      points: [
        'Upper and lower eyelid assessment',
        'Subtle eye-area rejuvenation',
        'Proportion-led planning'
      ]
    },
    {
      title: 'Breast Augmentation',
      image: '/assets/procedures/breast-augmentation.png',
      description:
        'Personalized enhancement shaped around body proportion, silhouette, and individual goals.',
      points: [
        'Proportion-conscious planning',
        'Individual implant selection',
        'Balanced silhouette'
      ]
    },
    {
      title: 'Body Contouring',
      image: '/assets/procedures/body-contouring.png',
      description:
        'Sculptural body refinement focused on proportion, contour, and a balanced overall silhouette.',
      points: [
        'Contour-focused planning',
        'Waist and silhouette refinement',
        'Individualized treatment strategy'
      ]
    }
  ];

  useEffect(() => {
    const element = headingRef.current;

    if (!element) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        setHeadingVisible(entry.isIntersecting);
      },
      {
        threshold: 0.35
      }
    );

    observer.observe(element);

    return () => observer.disconnect();
  }, []);

  useEffect(() => {
    if (!selectedProcedure) return;

    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';

    const handleKeyDown = (event) => {
      if (event.key === 'Escape') {
        closeProcedure();
      }
    };

    window.addEventListener('keydown', handleKeyDown);

    return () => {
      document.body.style.overflow = previousOverflow;
      window.removeEventListener('keydown', handleKeyDown);
    };
  }, [selectedProcedure]);

  const openProcedure = (procedure) => {
    setModalClosing(false);
    setSelectedProcedure(procedure);
  };

  const closeProcedure = () => {
    if (!selectedProcedure || modalClosing) return;

    setModalClosing(true);

    window.setTimeout(() => {
      setSelectedProcedure(null);
      setModalClosing(false);
    }, 360);
  };

  const goToConsultation = () => {
    closeProcedure();

    window.setTimeout(() => {
      document.getElementById('consultation')?.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    }, 80);
  };

  return (
    <section
      className="section-padding procedures-section procedures-editorial"
      id="procedures"
    >
      <div className="container">
        <div
          ref={headingRef}
          className={`procedures-heading ${
            headingVisible ? 'procedures-heading-visible' : ''
          }`}
        >
          <span className="procedures-kicker">
            AURELIS / PROCEDURES
          </span>

          <h2>
            <span
              className="procedure-heading-word"
              style={{ '--heading-index': 0 }}
            >
              Refinement,
            </span>

            <span
              className="procedure-heading-word"
              style={{ '--heading-index': 1 }}
            >
              not
            </span>

            <span
              className="procedure-heading-word"
              style={{ '--heading-index': 2 }}
            >
              reinvention.
            </span>
          </h2>

          <p>
            Five procedures. One point of view.
Refine what matters. Keep what doesn't need changing.
          </p>
        </div>

        <div className="procedure-gallery">
          {procedures.map((procedure, index) => (
            <button
              type="button"
              className={`procedure-visual-card procedure-visual-card-${index + 1}`}
              key={procedure.title}
              onClick={() => openProcedure(procedure)}
              aria-label={`Learn more about ${procedure.title}`}
            >
              <span className="procedure-image-frame">
                <img
                  src={procedure.image}
                  alt=""
                  className="procedure-image"
                />

                <span className="procedure-image-number">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <span className="procedure-image-action">
                  View procedure
                  <span aria-hidden="true">↗</span>
                </span>
              </span>

              <span className="procedure-caption">
                {procedure.title}
              </span>
            </button>
          ))}
        </div>
      </div>

      {selectedProcedure && (
        <div
          className={`procedure-modal-shell ${
            modalClosing ? 'procedure-modal-closing' : 'procedure-modal-open'
          }`}
          role="dialog"
          aria-modal="true"
          aria-label={selectedProcedure.title}
          onMouseDown={(event) => {
            if (event.target === event.currentTarget) {
              closeProcedure();
            }
          }}
        >
          <button
            type="button"
            className="procedure-modal-close"
            onClick={() => setSelectedProcedure(null)}
            aria-label="Close procedure"
          >
            ×
          </button>

          <div className="procedure-modal-stage">
            <div className="procedure-modal-image-wrap">
              <img
                src={selectedProcedure.image}
                alt=""
                className="procedure-modal-image"
              />
            </div>

            <div className="procedure-modal-copy">
              <span className="procedure-modal-label">
                AURELIS / PROCEDURE
              </span>

              <h3>{selectedProcedure.title}</h3>

              <p>{selectedProcedure.description}</p>

              <ul>
                {selectedProcedure.points.map((point) => (
                  <li key={point}>{point}</li>
                ))}
              </ul>

              <button
                type="button"
                className="procedure-modal-cta"
                onClick={goToConsultation}
              >
                Book Online Consultation
              </button>
            </div>
          </div>
        </div>
      )}
    </section>
  );
}
